[Plymouth Theme]
Name=ArmchyOS
Description=ArmchyOS splash screen: the chair fills in as the system boots (from Omarchy's theme).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/armchy
ScriptFile=/usr/share/plymouth/themes/armchy/armchy.script
ConsoleLogBackgroundColor=0x000000
MonospaceFont=Cantarell 11
Font=Cantarell 11
